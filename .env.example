# Alleen wijzigen als je van de standaard wilt afwijken.
APP_PORT=3210
BIND_ADDRESS=0.0.0.0
# Exacte browser-URL zonder afsluitende slash, bijv. http://192.168.1.50:3210.
# Bij directe toegang mag dit leeg blijven (de app gebruikt dan de Host-header).
APP_ORIGIN=
# Gebruik true wanneer je de app via HTTPS opent.
COOKIE_SECURE=false
# Alleen true achter een vertrouwde reverse proxy die forwarded headers overschrijft.
TRUST_PROXY=false
